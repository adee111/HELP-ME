{
  "name": "helpme-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "approve": "node --env-file-if-exists=.env scripts/approve.js",
    "grant-admin": "node --env-file-if-exists=.env scripts/grant-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "supabase": "2.118.0",
    "supertest": "7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.1"
  }
}
